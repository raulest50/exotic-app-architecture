diagram[name="LogicaGeneral"] controlflow[id="8bb3add5-df87-11f1-8255-bc09b9551b3f"] { color: #285f8f; text-color: #285f8f; }
diagram[name="LogicaGeneral"] controlflow[id="8bb4804f-df87-11f1-964a-bc09b9551b3f"] { color: #285f8f; text-color: #285f8f; }
diagram[name="LogicaGeneral"] controlflow[id="8bb518c4-df87-11f1-8ad4-bc09b9551b3f"] { color: #285f8f; text-color: #285f8f; }
diagram[name="LogicaGeneral"] controlflow[id="8bb5ac23-df87-11f1-b9d2-bc09b9551b3f"] { color: #9b5a08; text-color: #9b5a08; }
diagram[name="LogicaGeneral"] controlflow[id="8bb67b42-df87-11f1-b401-bc09b9551b3f"] { color: #24734d; text-color: #24734d; }
diagram[name="LogicaGeneral"] controlflow[id="8bb73da4-df87-11f1-af24-bc09b9551b3f"] { color: #66717f; text-color: #66717f; }
diagram[name="LogicaGeneral"] controlflow[id="8bb7dad8-df87-11f1-bc9e-bc09b9551b3f"] { color: #24734d; text-color: #24734d; }
diagram[name="LogicaGeneral"] controlflow[id="8bb899d7-df87-11f1-8abe-bc09b9551b3f"] { color: #ad3434; text-color: #ad3434; }
diagram[name="LogicaGeneral"] controlflow[id="8bb92f40-df87-11f1-80c4-bc09b9551b3f"] { color: #ad3434; text-color: #ad3434; }
diagram[name="LogicaGeneral"] controlflow[id="8bb9bf37-df87-11f1-9e60-bc09b9551b3f"] { color: #24734d; text-color: #24734d; }
diagram[name="LogicaGeneral"] controlflow[id="8bba4fc9-df87-11f1-b1bb-bc09b9551b3f"] { color: #24734d; text-color: #24734d; }
diagram[name="LogicaGeneral"] controlflow[id="8bbae350-df87-11f1-bf40-bc09b9551b3f"] { color: #66717f; text-color: #66717f; }


/* AgentAssistant: vistas locales de integración y uso, 2026-11-13. */
diagram[name="AgentAssistant — integración local"] { background-color: white; }
diagram[name="AgentAssistant — integración local"] * { color: #334155; text-color: #172f4a; font-family: sans-serif; font-size: 15; line-width: 1.3; }
diagram[name="AgentAssistant — integración local"] package { background-color: #f8fafc; }
diagram[name="AgentAssistant — integración local"] component { background-color: #e8f2fc; }
diagram[name="AgentAssistant — integración local"] dependency { color: #326389; text-color: #326389; font-size: 13; }
diagram[name="AgentAssistant — integración local"] comment { background-color: #fff9e8; font-size: 14; }
diagram[name="AgentAssistant — uso de solo lectura"] { background-color: white; }
diagram[name="AgentAssistant — uso de solo lectura"] * { color: #334155; text-color: #172f4a; font-family: sans-serif; font-size: 15; line-width: 1.4; }
diagram[name="AgentAssistant — uso de solo lectura"] action { background-color: #e8f2fc; }
diagram[name="AgentAssistant — uso de solo lectura"] action name { text-align: center; }
diagram[name="AgentAssistant — uso de solo lectura"] decisionnode { background-color: #eaf5ee; white-space: nowrap; text-align: left; vertical-align: middle; vertical-spacing: 12; }
diagram[name="AgentAssistant — uso de solo lectura"] controlflow { color: #326389; text-color: #326389; dash-style: 0; font-size: 13; }
diagram[name="AgentAssistant — uso de solo lectura"] comment { background-color: #fff9e8; font-size: 14; }
</val>
</styleSheet>
</Core:StyleSheet>
