<?xml version="1.0" encoding="utf-8"?>
<gaphor xmlns="https://gaphor.org/model" xmlns:Core="https://gaphor.org/modelinglanguage/Core" xmlns:UML="https://gaphor.org/modelinglanguage/UML" version="4" gaphor-version="3.3.2">
<model>
<Core:StyleSheet id="58d6989a-66f8-11ec-b4c8-0456e5e540ed">
<styleSheet>
<val>/* Nodos: título arriba a la izquierda */
node compartment:first-child {
    justify-content: start;
}
node name {
    text-align: left;
    vertical-align: top;
}

/* Packages: título arriba y centrado */
package name {
    text-align: center;
    vertical-align: top;
}

/* Colores exclusivos de Despliegue */
diagram[name="Despliegue"] node[name="render.com"] {
    background-color: #1976D2;   /* azul */
}

diagram[name="Despliegue"] node[name="Backend - Spring"] {
    background-color: #6DB33F;   /* verde spring */
}

diagram[name="Despliegue"] node[name="PostgresDatabase"] {
    background-color: #C62828;   /* rojo */
}

diagram[name="Despliegue"] node[name="PC - usuario"] {
    background-color: #9E9E9E;   /* gris */
}

diagram[name="Despliegue"] node[name="FrontEnd"] {
    background-color: #FBC02D;   /* amarillo */
    text-color: #212121;
}

/* Todos los componentes: título arriba y centrado */
component {
    justify-content: start;
}

component compartment:first-child {
    justify-content: start;
}

component name {
    text-align: center;
    vertical-align: top;
}</val>
</styleSheet>
</Core:StyleSheet>
