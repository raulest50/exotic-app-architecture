<?xml version="1.0" encoding="utf-8"?>
<gaphor xmlns="https://gaphor.org/model" xmlns:Core="https://gaphor.org/modelinglanguage/Core" xmlns:UML="https://gaphor.org/modelinglanguage/UML" version="4" gaphor-version="3.3.2">
<model>
<Core:StyleSheet id="58d6989a-66f8-11ec-b4c8-0456e5e540ed">
<styleSheet>
<val>/* Nodos: título arriba a la izquierda */
node compartment:first-child {
    justify-content: start;
}
node name {
    text-align: left;
    vertical-align: top;
}

/* Packages: título arriba y centrado */
package name {
    text-align: center;
    vertical-align: top;
}

/* Colores exclusivos de Despliegue */
diagram[name="Despliegue"] node[name="render.com"] {
    background-color: #1976D2;   /* azul */
}

diagram[name="Despliegue"] node[name="Backend - Spring"] {
    background-color: #6DB33F;   /* verde spring */
}

diagram[name="Despliegue"] node[name="PostgresDatabase"] {
    background-color: #C62828;   /* rojo */
}

diagram[name="Despliegue"] node[name="PC - usuario"] {
    background-color: #9E9E9E;   /* gris */
}

diagram[name="Despliegue"] node[name="FrontEnd"] {
    background-color: #FBC02D;   /* amarillo */
    text-color: #212121;
}

/* Todos los componentes: título arriba y centrado */
component {
    justify-content: start;
}

component compartment:first-child {
    justify-content: start;
}

component name {
    text-align: center;
    vertical-align: top;
}

/* Vista de destino propuesta; estilos acotados a este diagrama. */
diagram[name="deployment migracion"] { background-color: white; }
diagram[name="deployment migracion"] * {
    color: #24364b; text-color: #24364b; font-family: sans-serif; font-size: 14;
    line-width: 1.4;
}
diagram[name="deployment migracion"] node { background-color: #edf4fc; }
diagram[name="deployment migracion"] node node { background-color: #f8fafc; }
diagram[name="deployment migracion"] node node node { background-color: #e9f5ee; }
diagram[name="deployment migracion"] node name { text-align: left; vertical-align: top; }
diagram[name="deployment migracion"] comment { background-color: #fff9e8; }
diagram[name="deployment migracion"] association { font-size: 12; }
diagram[name="deployment migracion"] dependency { font-size: 12; }


/* Fotogrametría: legibilidad exclusiva de LogicaGeneral. */
diagram[name="LogicaGeneral"] { background-color: white; }
diagram[name="LogicaGeneral"] controlflow { dash-style: 0; }
diagram[name="LogicaGeneral"] decisionnode {
    white-space: nowrap; text-align: left; vertical-align: top; vertical-spacing: 10;
}
diagram[name="LogicaGeneral"] decisionnode[name="¿Cómo continuar?"] { text-align: right; }
diagram[name="LogicaGeneral"] initialnode {
    white-space: nowrap; text-align: left; vertical-align: middle; vertical-spacing: 10;
}

/* Fotogrametría: recorridos interiores y colores por función. */
diagram[name="LogicaGeneral"] controlflow { color: #285f8f; text-color: #285f8f; line-width: 1.8; }
diagram[name="LogicaGeneral"] partition { color: #64748b; text-color: #334155; line-width: 1; }
diagram[name="LogicaGeneral"] partition &gt; * { color: #334155; text-color: #334155; line-width: 1.25; }
diagram[name="LogicaGeneral"] controlflow[id="8bab5315-df87-11f1-a6f9-bc09b9551b3f"] { color: #285f8f; text-color: #285f8f; }
diagram[name="LogicaGeneral"] controlflow[id="8bab78d3-df87-11f1-83e7-bc09b9551b3f"] { color: #285f8f; text-color: #285f8f; }
diagram[name="LogicaGeneral"] controlflow[id="8babf130-df87-11f1-847e-bc09b9551b3f"] { color: #285f8f; text-color: #285f8f; }
diagram[name="LogicaGeneral"] controlflow[id="8bac7c6e-df87-11f1-8cb6-bc09b9551b3f"] { color: #285f8f; text-color: #285f8f; }
diagram[name="LogicaGeneral"] controlflow[id="8bad1da4-df87-11f1-92e6-bc09b9551b3f"] { color: #285f8f; text-color: #285f8f; }
diagram[name="LogicaGeneral"] controlflow[id="8bada096-df87-11f1-8806-bc09b9551b3f"] { color: #285f8f; text-color: #285f8f; }
diagram[name="LogicaGeneral"] controlflow[id="8bae1afc-df87-11f1-8b84-bc09b9551b3f"] { color: #285f8f; text-color: #285f8f; }
diagram[name="LogicaGeneral"] controlflow[id="8baeb502-df87-11f1-92d3-bc09b9551b3f"] { color: #285f8f; text-color: #285f8f; }
diagram[name="LogicaGeneral"] controlflow[id="8baf4509-df87-11f1-a2ce-bc09b9551b3f"] { color: #9b5a08; text-color: #9b5a08; }
diagram[name="LogicaGeneral"] controlflow[id="8bafe4c2-df87-11f1-bbba-bc09b9551b3f"] { color: #285f8f; text-color: #285f8f; }
