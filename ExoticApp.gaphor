diagram[name="LogicaGeneral"] controlflow[id="8bb112bf-df87-11f1-85aa-bc09b9551b3f"] { color: #285f8f; text-color: #285f8f; }
diagram[name="LogicaGeneral"] controlflow[id="8bb1ad4c-df87-11f1-8ba4-bc09b9551b3f"] { color: #285f8f; text-color: #285f8f; }
diagram[name="LogicaGeneral"] controlflow[id="8bb262ea-df87-11f1-97e5-bc09b9551b3f"] { color: #9b5a08; text-color: #9b5a08; }
