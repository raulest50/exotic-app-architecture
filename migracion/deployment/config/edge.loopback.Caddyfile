# Shared by the SSH-only and public entrypoints. No global options here.
# These listeners are published only on host loopback by both Compose variants.
(private_forwarding) {
	header_up -Forwarded
	header_up -X-Forwarded-Port
	header_up -X-Forwarded-Prefix
	header_up -X-Forwarded-Ssl
}

http://:15173 {
	reverse_proxy web-staging:8080 {
		import private_forwarding
	}
}

http://:18080 {
	reverse_proxy backend-staging:8080 {
		import private_forwarding
	}
}

http://:13000 {
	reverse_proxy web-production:8080 {
		import private_forwarding
	}
}

http://:18081 {
	reverse_proxy backend-production:8080 {
		import private_forwarding
	}
}
