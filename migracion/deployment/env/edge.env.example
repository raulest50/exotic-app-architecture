# EXAMPLE ONLY. Copy to a private file on the VM; never commit real credentials.
# Suggested private environment file: /srv/exotic/private/edge/edge.env
# Image reference is pinned; changing it requires a new configuration validation.
CADDY_IMAGE=caddy:2-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5
VM_PUBLIC_IP=34.30.31.30

# Agreed public names. Hostnames only: no scheme, port, slash, or path.
# The default ACME issuer supports registration without a contact email.
STAGING_WEB_DOMAIN=mrp.staging.exotic.com.co
STAGING_API_DOMAIN=mrp.api.staging.exotic.com.co
PRODUCTION_WEB_DOMAIN=mrp.prod.exotic.com.co
PRODUCTION_API_DOMAIN=mrp.api.prod.exotic.com.co

# Absolute path ON THE VM, not a Windows path or a path relative to the checkout.
# Create this directory manually with restricted permissions. Copy only reviewed
# production.caddy, staging.caddy and optionally ip.caddy files from examples.
# Do not point it at the repository's config/sites directory; .example files are
# not active sites. Activation does not perform a data/user cutover from Render.
EDGE_SITES_DIR=/srv/exotic/private/edge/sites

# Both external edge networks and both external TLS/config volumes are prepared
# explicitly before running Compose; see compose.edge.yaml and the main README.
# App projects use their matching edge network and their own data-only network.
