# PRIVATE SSH-ONLY EDGE. This file contains no passwords or domain settings.
# Suggested VM copy: /srv/exotic/private/edge/edge.private.env
# Use compose.edge.private.yaml alone, not together with compose.edge.yaml.
# The default image is pinned to the same digest as the public edge variant.
CADDY_IMAGE=caddy:2-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5

# These are fixed IPv4 loopback bindings on the VM, not public endpoints:
#   127.0.0.1:15173 -> web-staging:8080
#   127.0.0.1:18080 -> backend-staging:8080
#   127.0.0.1:13000 -> web-production:8080
#   127.0.0.1:18081 -> backend-production:8080
# No ACME email, public domain, certificate issuance, or TCP 80/443 is needed.
# Prepare both external edge networks and existing Caddy data/config volumes
# explicitly before starting the proxy; this file does not create resources.
#
# With the current unchanged frontend, browse http://localhost:5173 and keep
# its API at http://localhost:8080. Select ONE environment at a time by changing
# both SSH forwards together: staging 5173->15173 / 8080->18080, or production
# 5173->13000 / 8080->18081. Binding different local frontend ports alone would
# not switch the API selected by the application's existing localhost logic.
