# TEMPLATE: non-secret configuration only. Private copy lives on the VM.
# Suggested path: /srv/exotic/private/production/production.env
ENVIRONMENT=production
DB_NAME=exotic_production
DB_USER=exotic_production

# Do not enable until staging, restore and app compatibility are reviewed.
APP_COMPATIBILITY_CONFIRMED=false
BACKEND_IMAGE=registry.example.invalid/exotic/backend:REEMPLAZAR_COMMIT
FRONTEND_DIST_DIR=/srv/exotic/releases/production/REEMPLAZAR_COMMIT/frontend/dist
PUBLIC_DOMAIN=mrp.prod.exotic.com.co
API_PUBLIC_DOMAIN=mrp.api.prod.exotic.com.co
# Public build and SSH build coexist in the same web container.
PUBLIC_FRONTEND_HOST=mrp.prod.exotic.com.co
PUBLIC_FRONTEND_DIST_DIR=/srv/exotic/releases/production/REEMPLAZAR_COMMIT/frontend/dist-public
# Additional build made with --base=/prod/ and the IP API base URL.
IP_FRONTEND_HOST=34.30.31.30
IP_FRONTEND_DIST_DIR=/srv/exotic/releases/production/REEMPLAZAR_COMMIT/frontend/dist-ip

POSTGRES_IMAGE=postgres:18-bookworm@sha256:5c4783a8cc3f0074912164f94dfa1be4e043438f0f707cf968d7af9a0d31a2c8
CADDY_IMAGE=caddy:2-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5

POSTGRES_ADMIN_PASSWORD_FILE=/srv/exotic/private/production/postgres-admin-password
DB_PASSWORD_FILE=/srv/exotic/private/production/database-password
JWT_SECRET_FILE=/srv/exotic/private/production/jwt-secret
BACKEND_PROPERTIES_FILE=/srv/exotic/private/production/backend.properties

# Initial budgets; they are not a capacity guarantee or a CPU reservation.
BACKEND_CPU_LIMIT=0.65
BACKEND_CPU_SHARES=1024
BACKEND_MEMORY_LIMIT=2560m
BACKEND_DB_POOL_SIZE=10
DATABASE_CPU_LIMIT=0.30
DATABASE_MEMORY_LIMIT=1536m
DATABASE_SHM_SIZE=256m
DATABASE_SHARED_BUFFERS=256MB
DATABASE_MAX_CONNECTIONS=60
WEB_CPU_LIMIT=0.04

# Production backup refuses placeholders and requires a real remote destination.
BACKUP_REMOTE_URI=gs://REEMPLAZAR_BUCKET/exotic/production
