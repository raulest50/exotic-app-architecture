# TEMPLATE: non-secret configuration only. Private copy lives on the VM.
# Suggested path: /srv/exotic/private/staging/staging.env
ENVIRONMENT=staging
DB_NAME=exotic_staging
DB_USER=exotic_staging

# Requires reviewed app changes listed in docs/COMPATIBILIDAD.md.
# Leave false until the image, frontend API origin and CORS have been verified.
APP_COMPATIBILITY_CONFIRMED=false
BACKEND_IMAGE=registry.example.invalid/exotic/backend:REEMPLAZAR_COMMIT
FRONTEND_DIST_DIR=/srv/exotic/releases/staging/REEMPLAZAR_COMMIT/frontend/dist
PUBLIC_DOMAIN=mrp.staging.exotic.com.co
API_PUBLIC_DOMAIN=mrp.api.staging.exotic.com.co
# Public build and SSH build coexist in the same web container.
PUBLIC_FRONTEND_HOST=mrp.staging.exotic.com.co
PUBLIC_FRONTEND_DIST_DIR=/srv/exotic/releases/staging/REEMPLAZAR_COMMIT/frontend/dist-public
# Additional build made with --base=/staging/ and the IP API base URL.
IP_FRONTEND_HOST=34.30.31.30
IP_FRONTEND_DIST_DIR=/srv/exotic/releases/staging/REEMPLAZAR_COMMIT/frontend/dist-ip

# Registry digests verified locally. Review version upgrades explicitly.
POSTGRES_IMAGE=postgres:18-bookworm@sha256:5c4783a8cc3f0074912164f94dfa1be4e043438f0f707cf968d7af9a0d31a2c8
CADDY_IMAGE=caddy:2-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5

# Paths are absolute ON THE VM. Four separate files, never their secret values.
POSTGRES_ADMIN_PASSWORD_FILE=/srv/exotic/private/staging/postgres-admin-password
DB_PASSWORD_FILE=/srv/exotic/private/staging/database-password
JWT_SECRET_FILE=/srv/exotic/private/staging/jwt-secret
BACKEND_PROPERTIES_FILE=/srv/exotic/private/staging/backend.properties

# Initial budgets, NOT proven production sizing; account for both environments.
BACKEND_CPU_LIMIT=0.20
BACKEND_CPU_SHARES=256
BACKEND_MEMORY_LIMIT=1536m
BACKEND_DB_POOL_SIZE=5
DATABASE_CPU_LIMIT=0.10
DATABASE_MEMORY_LIMIT=768m
DATABASE_SHM_SIZE=128m
DATABASE_SHARED_BUFFERS=128MB
DATABASE_MAX_CONNECTIONS=30
WEB_CPU_LIMIT=0.03

# Empty permits a local staging rehearsal. Before migration use an external
# destination with tested access, e.g. gs://your-private-bucket/exotic/staging.
BACKUP_REMOTE_URI=
